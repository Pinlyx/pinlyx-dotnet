<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <RootNamespace>CrmSolid</RootNamespace>
    <AssemblyName>CrmSolid</AssemblyName>

    <PackageId>CrmSolid</PackageId>
    <Title>Pinlyx .NET SDK</Title>
    <Description>Official .NET SDK for the Pinlyx omnichannel AI CRM platform. Strongly-typed clients for the public REST API v1 (Bearer auth): contacts, deals, tasks, finance, email inbox, Telegram + Twitter/X messaging, sequences, analytics, conversations, accounts, pipelines, AI agents, job monitor, and self-service webhooks + API keys — with scope-aware, safe-write semantics and webhook signature verification. Also HMAC-signed /public endpoints and an MCP client wrapper. Multi-targets netstandard2.0, net8.0, and net9.0.</Description>
    <Version>0.3.0-alpha.1</Version>
    <PackageTags>crm;crmsolid;pinlyx;sdk;api-client;telegram;twitter;webhooks;mcp;nuget</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrmSolid.Tests" />
  </ItemGroup>

</Project>
