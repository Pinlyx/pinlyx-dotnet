<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <RootNamespace>CrmSolid</RootNamespace>
    <AssemblyName>CrmSolid</AssemblyName>

    <PackageId>CrmSolid</PackageId>
    <Title>CRM Solid .NET SDK</Title>
    <Description>Official .NET SDK for the CRM Solid omnichannel AI CRM platform. Strongly-typed clients for the public REST API v1 (Bearer auth) and HMAC-signed /public endpoints, plus an MCP client wrapper. Multi-targets netstandard2.0, net8.0, and net9.0.</Description>
    <Version>0.1.0-alpha.1</Version>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrmSolid.Tests" />
  </ItemGroup>

</Project>
